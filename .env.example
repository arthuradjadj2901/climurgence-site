# ════════════════════════════════════════════════════════════════════
# Site climurgence.com — variables d'environnement
# ════════════════════════════════════════════════════════════════════
#
# Copier ce fichier en `.env.local` pour tester en local avec `vercel dev`.
# En prod : ajouter ces variables dans Vercel Dashboard
#   → Settings → Environment Variables (Production + Preview).
#
# ⚠️ Ne JAMAIS commiter `.env.local` (il est déjà dans .gitignore).
# ════════════════════════════════════════════════════════════════════

# ── Resend (envoi des emails leads) ──────────────────────────────────
# Dashboard : https://resend.com/api-keys
# Important : créer une clé DÉDIÉE au site (ne pas réutiliser celle du CRM,
# cloisonnement explicite voulu pour limiter le rayon de panne).
RESEND_API_KEY_SITE=re_xxxxxxxxxxxxxxxxxxxx

# ── Destinataire des emails leads ────────────────────────────────────
LEAD_EMAIL_TO=contact@climurgence.com

# ── Mode dry-run (test local sans envoyer de vrai mail) ──────────────
# 1 = logger l'email dans la console au lieu de l'envoyer (utile en dev)
# 0 = envoyer réellement les emails (prod)
LEAD_EMAIL_DRY_RUN=0

# ── Upstash Redis (rate limit anti-spam : 5 leads / 10 min / IP) ─────
# Dashboard : https://console.upstash.com
# Ces variables existent peut-être déjà sous les noms `KV_REST_API_URL` /
# `KV_REST_API_TOKEN` (anciens noms Vercel KV). Le code de /api/lead lit
# en priorité les noms standards Upstash ci-dessous, et bascule sur les
# noms KV_* si nécessaire.
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxx
